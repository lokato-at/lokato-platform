# =============================================================================
# Zeilenenden — Dateien, die auf dem Raspberry Pi (Linux) laufen, MUESSEN LF
# behalten. CRLF bricht dort den Shebang ("/usr/bin/env bash^M: bad interpreter")
# bzw. Config-/Unit-Parser. Diese Regeln erzwingen LF im Repo UND beim Checkout,
# egal von welchem OS (auch Windows) committet wird.
# =============================================================================
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
