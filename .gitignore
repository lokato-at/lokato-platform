# PHP / Laravel (backend)  
############################

# Composer
backend/vendor/
backend/composer.phar

# Laravel Env-Dateien
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.raspi.example
backend/.env.backup

# Storage & Cache 
# 1. Alles im Storage-Ordner ignorieren
backend/storage/*

# 2. Die Ordnerstruktur explizit erlauben (damit Git hineinschaut)
!backend/storage/framework/
!backend/storage/framework/views/
!backend/storage/framework/cache/
!backend/storage/framework/sessions/

# 3. Die .gitignore-Dateien explizit erlauben
!backend/storage/framework/views/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore

# 4. Andere spezifische Dateien/Ordner
backend/storage/*.key
backend/storage/logs/*

# AI / Tools
**/.claude/
**/.cursor/
**/.junie/

# Branding — pro Einrichtung individuell, NICHT einchecken.
# Nur die *.example und die Ordnerstruktur (README + .gitkeep) gehören ins Repo.
frontend/public/branding/config.json
frontend/public/branding/facility-logo.*
frontend/public/branding/facility-banner.*
frontend/public/branding/dashboard/*
!frontend/public/branding/dashboard/.gitkeep
frontend/public/branding/children/*
!frontend/public/branding/children/.gitkeep
frontend/public/branding/animations/*
!frontend/public/branding/animations/.gitkeep

# Public Symlink / Hot Reload
backend/public/storage
backend/public/hot

# PHP & Test-Caches
backend/.phpunit.result.cache
**/.phpunit.result.cache
backend/.php-cs-fixer.cache
**/.php-cs-fixer.cache
backend/.phpstorm.meta.php

# Static Analysis Caches
backend/.phpstan.cache
**/.phpstan.cache
backend/.psalm/cache
**/.psalm/cache


