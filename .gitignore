!frontend/.env.raspi.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
**/*.tsbuildinfo

# Lint/Formatter Caches
**/.eslintcache
**/.stylelintcache
