# =============================================================================
# Lokato Backend — Produktion Raspberry Pi (nativ via apt)
# -----------------------------------------------------------------------------
# Diese Datei wird von start-prod-raspi.sh beim ERSTEN Lauf nach `.env` kopiert.
# Sobald `.env` existiert, wird sie NICHT mehr ueberschrieben — eigene
# Anpassungen (echte IP, DB-Credentials, APP_KEY) bleiben erhalten.
#
# Pflicht-Anpassungen nach der Erstinstallation:
#   - APP_URL          echte Pi-IP eintragen (oder Hostname)
#   - DB_PASSWORD      starkes Passwort statt 'changeme'
#   - APP_KEY          bleibt leer, wird durch `php artisan key:generate` gesetzt
# =============================================================================

APP_NAME=Lokato
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.100

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT
APP_TIMEZONE=Europe/Vienna

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

API_SLOW_REQUEST_MS=400
SSE_MAX_CONNECTION_SECONDS=60

# -----------------------------
# Database (nativ auf dem Pi, lokal via 127.0.0.1)
# -----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lokato_db
DB_USERNAME=lokato
DB_PASSWORD=changeme

# -----------------------------
# Session / Cache / Queue — alles ueber database-Driver (kein Redis noetig)
# -----------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------
# Mail (nur log in Produktion)
# -----------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------
# MQTT (Mosquitto nativ auf dem Pi, lokal via 127.0.0.1)
# -----------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=lokato-laravel-subscriber
MQTT_ENABLE_LOGGING=true
MQTT_AUTH_USERNAME=
MQTT_AUTH_PASSWORD=
MQTT_TOPIC_SCAN=/api/v1/scan
MQTT_QOS=0
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_LOG_CHANNEL=scan
# Library-Auto-Reconnect MUSS aus sein, weil es mit clean_session=true kollidiert
# (php-mqtt/client lehnt das ab: "Automatic reconnects cannot be used together
# with the clean session flag"). systemd-Restart in lokato-mqtt.service uebernimmt
# die Crash-Recovery (Restart=always, RestartSec=5).
MQTT_AUTO_RECONNECT_ENABLED=false
MQTT_AUTO_RECONNECT_MAX_ATTEMPTS=10
MQTT_AUTO_RECONNECT_DELAY=2
MQTT_LATENCY_WARN_MS=3000

# Topics fuers Frontend-Subscriben (Browser via MQTT-over-WS — derzeit ungenutzt,
# aber im Schema vorgesehen).
MQTT_TOPIC_ROOM_STATE_PREFIX=lokato/rooms
MQTT_TOPIC_MOVEMENTS=lokato/movements/recent
MQTT_TOPIC_ALERTS=lokato/alerts/raised

# -----------------------------
# Frontend (Vite)
# -----------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------
# Logging / Diagnostics — in Produktion sparsam
# -----------------------------
# -----------------------------
# Admin-User (Pflicht in Prod: Passwort vor dem ersten Seed-Lauf setzen)
# -----------------------------
ADMIN_USER_EMAIL=admin@lokato.local
ADMIN_USER_NAME="Lokato Admin"
ADMIN_USER_PASSWORD=

# Throttle pro Source-IP -- schuetzt /api/v1/scan gegen Flooding
SCAN_RATE_LIMIT_PER_MINUTE=120

LOG_ENABLED=true
LOG_FORMAT=pretty
MQTT_DIAGNOSTIC_LOGS=false
SCAN_DIAGNOSTIC_LOGS=false
CRON_LOGS=true
DB_DIAGNOSTIC_LOGS=false
DIAGNOSTICS_ENABLED=true
