# =============================================================================
# Lokato Frontend — Produktion Raspberry Pi
# -----------------------------------------------------------------------------
# Same-Origin-Setup: nginx auf dem Pi liefert frontend/dist statisch aus UND
# proxyt /api/* an php-fpm. Deshalb hier ein RELATIVER Pfad ohne Host/IP.
#
# Damit ist die Pi-IP NICHT im JS-Bundle baked-in. Wechselt der Pi seine IP,
# muessen nur die Bookmarks der Tablets aktualisiert werden — kein
# `npm run build` mehr noetig.
#
# Diese Datei wird von start-prod-raspi.sh beim ERSTEN Lauf nach `.env` kopiert.
# =============================================================================

VITE_API_BASE_URL=/api/v1
