{
  "log_files": [
    "backend/storage/logs/scan.log",
    "backend/storage/logs/cron.log",
    "backend/storage/logs/laravel.log",
    "backend/storage/logs/sse.log"
  ],
  "system_log_files": [
    "/var/log/nginx/error.log",
    "/var/log/lokato/php-fpm.log",
    "/var/log/lokato/scheduler.log"
  ],
  "systemd_units": [
    "lokato-mqtt",
    "nginx",
    "mariadb",
    "mosquitto",
    "php8.4-fpm"
  ],
  "restart_counter_warn_threshold": 10,
  "retention_days": 14,
  "latency_warn_ms": 3000,
  "patterns": {
    "scan_success": ["scan_processed", "mqtt_message_processed", "movement_id"],
    "mqtt_connected": ["mqtt_connection_initialized"],
    "mqtt_subscribed": ["mqtt_subscribed"],
    "mqtt_received": ["mqtt_message_received"],
    "mqtt_ignored": ["mqtt_message_ignored"],
    "mqtt_latency": ["mqtt_latency_warning"],
    "mqtt_validation": ["mqtt_payload_validation_failed", "mqtt_payload_json_decode_failed", "mqtt_event_time_invalid"],
    "db_errors": ["SQLSTATE", "QueryException", "database", "db.*failed"],
    "daily_reset_success": ["daily_reset_finished"],
    "daily_reset_failed": ["daily_reset_failed"],
    "nginx_errors": ["upstream", " 5\\d{2} ", "connect\\(\\) failed", "no live upstreams", "emerg", "alert"],
    "scheduler_errors": ["PHP Fatal", "PHP Parse", "Uncaught", "Exception"],
    "errors": ["\\berror\\b", "\\bexception\\b", "\\bfailed\\b", "SQLSTATE"]
  }
}
